# 复制为 .env 后按实际情况改。.env 已被 .gitignore 忽略，不要提交真实密码。
# 后端读取：server/src/index.js 通过 dotenv 加载根目录的 .env

# ── 服务 ─────────────────────────────
PORT=8787
# 0.0.0.0 = 允许局域网访问（手机真机联调必需）；只想本机用可改 127.0.0.1
HOST=0.0.0.0

# ── MySQL（阶段 1 起使用）────────────
# 本机方案（当前使用）：用本机装的 mysqld 8.0.46，数据目录在仓库 data/mysql（已 gitignore），
#   单独跑在 3307，不碰 3306 上已有的实例。
#   启动：server/scripts/db.cmd（或手动 mysqld --no-defaults --datadir=... --port=3307 --console）
# Docker 方案（备选）：docker compose up -d 起 mysql:8.4 映射 3307。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=pantry
DB_NAME=pantry

# ── 认证（阶段 2 起使用）─────────────
# 任意长随机串，改了所有已签发的 token 失效
JWT_SECRET=change-me-to-a-long-random-string

# ── LLM（阶段 4 起使用）──────────────
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 抽取超时（毫秒）与重试次数，写死在 env 里方便调参和写进评测记录
EXTRACT_TIMEOUT_MS=15000
EXTRACT_RETRY=1

# ── 前端（放在 web/.env.local）────────
# 默认走 vite 代理，只有后端和前端不同源时才需要改
VITE_API_BASE=/api
