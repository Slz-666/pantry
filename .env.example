# 复制为 .env 后按实际情况改。.env 已被 .gitignore 忽略，不要提交真实密码。
# 后端读取：server/src/index.js 通过 dotenv 加载根目录的 .env

# ── 服务 ─────────────────────────────
PORT=8787
# 0.0.0.0 = 允许局域网访问（手机真机联调必需）；只想本机用可改 127.0.0.1
HOST=0.0.0.0

# ── MySQL（阶段 1 起使用）────────────
# 推荐的 Docker 方案映射到 3307，避开本机已有的 3306 实例：
#   docker run -d --name pantry-mysql -e MYSQL_ROOT_PASSWORD=pantry \
#     -e MYSQL_DATABASE=pantry -p 3307:3306 mysql:8.4
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=pantry
DB_NAME=pantry

# ── 认证（阶段 2 起使用）─────────────
# 任意长随机串，改了所有已签发的 token 失效
JWT_SECRET=change-me-to-a-long-random-string

# ── LLM（阶段 4 起使用）──────────────
DEEPSEEK_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 抽取超时（毫秒）与重试次数，写死在 env 里方便调参和写进评测记录
EXTRACT_TIMEOUT_MS=15000
EXTRACT_RETRY=1

# ── 前端（放在 web/.env.local）────────
# 默认走 vite 代理，只有后端和前端不同源时才需要改
VITE_API_BASE=/api
