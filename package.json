{
  "name": "pantry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "家里有什么 —— 家庭物资与效期管理 PWA",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\""
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
